<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                                       xmlns:app="http://schemas.android.com/apk/res-auto"
                                       xmlns:tools="http://schemas.android.com/tools"
                                       android:layout_width="match_parent"
                                       android:layout_height="match_parent"
                                       android:background="@color/brand_background"
                                       android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_screen_horizontal">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/configuraci_n_asis"
                android:textColor="@color/brand_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textAlignment="center"/>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Horarios de marcación"
                        android:textColor="@color/brand_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                <Space
                        android:layout_width="match_parent"
                        android:layout_height="12dp"/>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:gravity="center_vertical">

                    <TextView
                            android:id="@+id/txtHoraEntrada"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:padding="16dp"
                            android:gravity="center"
                            android:text="08:25"
                            android:textSize="22sp"
                            android:textColor="@color/black"
                            android:background="@color/brand_accent"
                            tools:ignore="HardcodedText"/>

                    <TextView
                            android:id="@+id/txtHoraSalida"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:padding="16dp"
                            android:gravity="center"
                            android:text="18:35"
                            android:textSize="22sp"
                            android:textColor="@color/black"
                            android:background="@color/brand_accent"
                            tools:ignore="HardcodedText"/>

                </LinearLayout>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Toca para cambiar hora"
                        android:textSize="12sp"
                        android:textColor="@color/brand_text_secondary"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo de operación"
                        android:textColor="@color/brand_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                <Space
                        android:layout_width="match_parent"
                        android:layout_height="12dp"/>

                <Switch
                        android:id="@+id/switchAutomatico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modo Automático"
                        android:buttonTint="@color/brand_primary"
                        tools:ignore="UseSwitchCompatOrMaterialCode,HardcodedText"/>

                <Switch
                        android:id="@+id/switchActivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Activar Asistencia"
                        android:buttonTint="@color/brand_primary"
                        tools:ignore="UseSwitchCompatOrMaterialCode,HardcodedText"/>

                <Switch
                        android:id="@+id/switchFeriados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ignorar feriados nacionales"
                        android:buttonTint="@color/brand_primary"
                        tools:ignore="UseSwitchCompatOrMaterialCode,HardcodedText"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Días activos"
                        android:textColor="@color/brand_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                <Space
                        android:layout_width="match_parent"
                        android:layout_height="8dp"/>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                        <CheckBox
                                android:id="@+id/checkLunes"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Lunes"
                                android:buttonTint="@color/brand_primary"
                                tools:ignore="HardcodedText"/>

                        <CheckBox
                                android:id="@+id/checkMartes"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Martes"
                                android:buttonTint="@color/brand_primary"
                                tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                        <CheckBox
                                android:id="@+id/checkMiercoles"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Miércoles"
                                android:buttonTint="@color/brand_primary"
                                tools:ignore="HardcodedText"/>

                        <CheckBox
                                android:id="@+id/checkJueves"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Jueves"
                                android:buttonTint="@color/brand_primary"
                                tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                        <CheckBox
                                android:id="@+id/checkViernes"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Viernes"
                                android:buttonTint="@color/brand_primary"
                                tools:ignore="HardcodedText"/>

                        <CheckBox
                                android:id="@+id/checkSabado"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Sábado"
                                android:buttonTint="@color/brand_primary"
                                tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/checkDomingo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Domingo"
                            android:buttonTint="@color/brand_primary"
                            tools:ignore="HardcodedText"/>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
                android:layout_width="match_parent"
                android:layout_height="16dp"/>

        <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:text="Guardar Configuración"
                android:backgroundTint="@color/brand_primary_light"
                android:textColor="@color/brand_on_primary"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_save"
                android:drawablePadding="10dp"
                android:drawableTint="@color/brand_on_primary"
                tools:ignore="HardcodedText"/>

        <Button
                android:id="@+id/btnVerAsistencia"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:text="Ver Historial"
                android:backgroundTint="@color/brand_primary"
                android:textColor="@color/brand_on_primary"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_history"
                android:drawablePadding="10dp"
                android:drawableTint="@color/brand_on_primary"
                tools:ignore="HardcodedText"/>

        <Button
                android:id="@+id/btnMarcarAhora"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Marcar Asistencia Ahora"
                android:backgroundTint="@color/brand_accent"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="4dp"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawablePadding="10dp"
                android:drawableTint="@color/black"
                tools:ignore="HardcodedText"/>

        <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="32dp"
                android:text="Cerrar Sesión"
                android:backgroundTint="@color/brand_danger"
                android:textColor="@color/brand_on_primary"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_logout"
                android:drawablePadding="10dp"
                android:drawableTint="@color/brand_on_primary"
                tools:ignore="HardcodedText"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
