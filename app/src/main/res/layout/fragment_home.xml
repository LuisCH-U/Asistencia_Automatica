<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                                       xmlns:app="http://schemas.android.com/apk/res-auto"
                                       xmlns:tools="http://schemas.android.com/tools"
                                       android:layout_width="match_parent"
                                       android:layout_height="match_parent"
                                       android:background="@color/brand_background"
                                       android:fillViewport="true"
                                       tools:ignore="HardcodedText">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_screen_horizontal">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/configuraci_n_asis"
                android:textColor="@color/brand_text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textAlignment="center"/>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_medium"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Horarios"
                            android:src="@drawable/ic_alarm"
                            app:tint="@color/brand_primary"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Horarios de marcación"
                            android:textColor="@color/brand_text_primary"
                            android:textSize="@dimen/text_size_section"
                            android:textStyle="bold"/>
                </LinearLayout>

                <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="Entrada"
                                android:textColor="@color/brand_text_secondary"
                                android:textSize="@dimen/text_size_label"
                                android:textStyle="bold"/>

                        <TextView
                                android:id="@+id/txtHoraEntrada"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/height_chip_time"
                                android:gravity="center"
                                android:background="@drawable/bg_chip_time"
                                android:text="08:25"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/brand_on_primary_container"/>
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="Salida"
                                android:textColor="@color/brand_text_secondary"
                                android:textSize="@dimen/text_size_label"
                                android:textStyle="bold"/>

                        <TextView
                                android:id="@+id/txtHoraSalida"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/height_chip_time"
                                android:gravity="center"
                                android:background="@drawable/bg_chip_time"
                                android:text="18:35"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/brand_on_primary_container"/>
                    </LinearLayout>

                </LinearLayout>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Toca para cambiar hora"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/brand_text_secondary"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_medium"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Modo de operación"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/brand_primary"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo de operación"
                            android:textColor="@color/brand_text_primary"
                            android:textSize="@dimen/text_size_section"
                            android:textStyle="bold"/>
                </LinearLayout>

                <Space
                        android:layout_width="match_parent"
                        android:layout_height="8dp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutomatico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Modo Automático"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/brand_text_primary"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchActivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Activar Asistencia"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/brand_text_primary"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFeriados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ignorar feriados nacionales"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/brand_text_primary"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_medium"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Días activos"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/brand_primary"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Días activos"
                            android:textColor="@color/brand_text_primary"
                            android:textSize="@dimen/text_size_section"
                            android:textStyle="bold"/>
                </LinearLayout>

                <Space
                        android:layout_width="match_parent"
                        android:layout_height="8dp"/>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                        <CheckBox
                                android:id="@+id/checkLunes"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="48dp"
                                android:text="Lunes"
                                android:textSize="15sp"
                                android:buttonTint="@color/brand_primary"/>

                        <CheckBox
                                android:id="@+id/checkMartes"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="48dp"
                                android:text="Martes"
                                android:textSize="15sp"
                                android:buttonTint="@color/brand_primary"/>
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                        <CheckBox
                                android:id="@+id/checkMiercoles"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="48dp"
                                android:text="Miércoles"
                                android:textSize="15sp"
                                android:buttonTint="@color/brand_primary"/>

                        <CheckBox
                                android:id="@+id/checkJueves"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="48dp"
                                android:text="Jueves"
                                android:textSize="15sp"
                                android:buttonTint="@color/brand_primary"/>
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                        <CheckBox
                                android:id="@+id/checkViernes"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="48dp"
                                android:text="Viernes"
                                android:textSize="15sp"
                                android:buttonTint="@color/brand_primary"/>

                        <CheckBox
                                android:id="@+id/checkSabado"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="48dp"
                                android:text="Sábado"
                                android:textSize="15sp"
                                android:buttonTint="@color/brand_primary"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/checkDomingo"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Domingo"
                            android:textSize="15sp"
                            android:buttonTint="@color/brand_primary"/>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="Guardar Configuración"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_primary"
                app:icon="@drawable/ic_save"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:cornerRadius="@dimen/corner_radius_button"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerAsistencia"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:text="Ver Historial"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_primary_container"
                app:iconTint="@color/brand_on_primary_container"
                android:textColor="@color/brand_on_primary_container"
                app:icon="@drawable/ic_history"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:cornerRadius="@dimen/corner_radius_button"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarcarAhora"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Marcar Asistencia Ahora"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_accent"
                android:textColor="@color/brand_on_accent"
                app:iconTint="@color/brand_on_accent"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:cornerRadius="@dimen/corner_radius_button"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginBottom="32dp"
                android:text="Cerrar Sesión"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:textColor="@color/brand_danger"
                app:strokeColor="@color/brand_danger"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/brand_danger"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:cornerRadius="@dimen/corner_radius_button"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
