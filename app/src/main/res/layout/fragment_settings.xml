<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                                       xmlns:app="http://schemas.android.com/apk/res-auto"
                                       xmlns:tools="http://schemas.android.com/tools"
                                       android:layout_width="match_parent"
                                       android:layout_height="match_parent"
                                       android:background="@color/brand_background"
                                       android:fillViewport="true"
                                       tools:ignore="HardcodedText">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_screen_horizontal">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="Configuración"
                android:textColor="@color/brand_text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textAlignment="center"/>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_medium"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <FrameLayout
                            android:layout_width="@dimen/icon_circle_size"
                            android:layout_height="@dimen/icon_circle_size"
                            android:background="@drawable/bg_icon_circle">

                        <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="Tema"
                                android:src="@drawable/ic_dark_mode"
                                app:tint="@color/brand_primary"/>
                    </FrameLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_medium"
                            android:orientation="vertical">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tema"
                                android:textColor="@color/brand_text_primary"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"/>

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Elige el tema de la app"
                                android:textColor="@color/brand_text_secondary"
                                android:textSize="@dimen/text_size_label"/>
                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/grupoTema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_medium"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTemaSistema"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Sistema"
                            android:textAllCaps="false"
                            android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTemaClaro"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Claro"
                            android:textAllCaps="false"
                            android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTemaOscuro"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Oscuro"
                            android:textAllCaps="false"
                            android:textSize="13sp"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_medium"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_divider"
                app:cardBackgroundColor="@color/brand_surface">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_medium">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <FrameLayout
                            android:layout_width="@dimen/icon_circle_size"
                            android:layout_height="@dimen/icon_circle_size"
                            android:background="@drawable/bg_icon_circle">

                        <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="Cuenta"
                                android:src="@drawable/ic_logout"
                                app:tint="@color/brand_danger"/>
                    </FrameLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_medium"
                            android:orientation="vertical">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cuenta"
                                android:textColor="@color/brand_text_primary"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"/>

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Cierra la sesión actual"
                                android:textColor="@color/brand_text_secondary"
                                android:textSize="@dimen/text_size_label"/>
                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCerrarSesion"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_button"
                        android:layout_marginTop="@dimen/space_medium"
                        android:text="Cerrar Sesión"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:textColor="@color/brand_danger"
                        app:strokeColor="@color/brand_danger"
                        app:icon="@drawable/ic_logout"
                        app:iconTint="@color/brand_danger"
                        app:iconGravity="start"
                        app:iconPadding="12dp"
                        app:cornerRadius="@dimen/corner_radius_button"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

            <TextView
                    android:id="@+id/txtVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asis v1.3"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Created by Luis CH. U."
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
