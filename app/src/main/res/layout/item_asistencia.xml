<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/corner_radius_card"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/brand_divider"
        app:cardBackgroundColor="@color/brand_surface"
        tools:ignore="HardcodedText">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_medium">

        <FrameLayout
                android:layout_width="@dimen/icon_circle_size"
                android:layout_height="@dimen/icon_circle_size"
                android:background="@drawable/bg_icon_circle">

            <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="Asistencia registrada"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/brand_primary"/>
        </FrameLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_medium"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/item_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Nombre Apellidos"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"/>

            <TextView
                    android:id="@+id/item_grupo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Grupo"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="@dimen/text_size_label"/>

            <TextView
                    android:id="@+id/item_codigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_code"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Cód. 0000"
                    android:textColor="@color/brand_on_primary_container"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_medium"
                android:orientation="vertical"
                android:gravity="end">

            <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Fecha"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/brand_primary"/>

            <TextView
                    android:id="@+id/item_fecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025-01-01"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="@dimen/text_size_label"
                    android:textStyle="bold"/>

            <TextView
                    android:id="@+id/item_hora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="09:00"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="@dimen/text_size_caption"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
