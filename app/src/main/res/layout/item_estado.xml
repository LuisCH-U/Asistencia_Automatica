<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/corner_radius_card"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/brand_divider"
        app:cardBackgroundColor="@color/brand_surface"
        tools:ignore="HardcodedText">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/space_large">

        <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_circle">

            <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Estado"
                    android:src="@drawable/ic_history"
                    app:tint="@color/brand_primary"/>
        </FrameLayout>

        <TextView
                android:id="@+id/estado_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="Título"
                android:textColor="@color/brand_text_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"/>

        <TextView
                android:id="@+id/estado_mensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Mensaje"
                android:textColor="@color/brand_text_secondary"
                android:textSize="@dimen/text_size_label"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
